			id: "150CEB7BC8DD564E"
			shape: "heart"
			size: 3.0d
			subtitle: "流派是指具有相近机制且能相互配合的一系列材料"
			tasks: [{
				id: "74DFA46B0CF1395F"
				title: "关于流派"
